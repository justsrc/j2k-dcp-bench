+    /// buffer. Every failure leaves the output untouched. Returns the native
+    /// layout the decode used. The request routes through the library's
+    /// prepared-direct runtime — its fastest Metal path, measured ~2× faster
+    /// than executing through a caller-owned session — and an explicit Metal
+    /// request is still rejected when the layout is unrepresentable, so no
+    /// error path ever substitutes CPU output for Metal output.
+    pub(crate) fn metal_decode_full(
+        &mut self,
+        options: J2kCDecodeOptions,
+        output: &mut [u8],
+        stride: usize,
+    ) -> Result<J2kCOutputInfo> {
+        if self.metal.is_none() {
+            return Err(Error::new(
+                J2K_UNSUPPORTED,
+                "the Metal backend is not initialized",
+            ));
+        }
+        let info = self.output_info_native(options)?;
+        let required = self.output_span(info, stride)?;
+        if output.len() < required {
+            return Err(Error::new(
+                J2K_BUFFER_TOO_SMALL,
+                "output buffer is shorter than the requested strided image",
+            ));
+        }
+        let fmt = core_pixel_format(&info).ok_or_else(|| {
+            Error::new(J2K_UNSUPPORTED, "Metal decode does not represent this layout")
+        })?;
+        let bytes = Arc::clone(&self.bytes);
+        let request = j2k_metal::MetalDecodeRequest::full(fmt, BackendRequest::Metal);
+        let surface = {
+            let mut decoder =
+                j2k_metal::J2kDecoder::new(&bytes).map_err(|error| metal_error(&error))?;
+            decoder
+                .decode_request_to_device(request)
+                .map_err(|error| metal_error(&error))?
+        };
+        surface
+            .download_into(&mut output[..required], stride)
+            .map_err(|error| metal_error(&error))?;
+        Ok(info)
+    }
+}
+
+/// Fork addition: map a Metal backend failure to the C ABI status codes.
+#[cfg(feature = "metal")]
+fn metal_error(error: &j2k_metal::Error) -> Error {
+    let message = error.to_string();
+    let code = match error {
+        j2k_metal::Error::Decode(source) => return Error::codec(source),
+        j2k_metal::Error::BatchInfrastructure(source) => {
+            return Error::infrastructure(source.clone())
+        }
+        j2k_metal::Error::Buffer(_) => J2K_BUFFER_TOO_SMALL,
+        j2k_metal::Error::UnsupportedBackend { .. }
+        | j2k_metal::Error::UnsupportedMetalRequest { .. }
+        | j2k_metal::Error::MetalUnavailable => J2K_UNSUPPORTED,
+        _ => J2K_DECODE_FAILED,
+    };
+    Error::new(code, message)
+}

+    decoder: *mut J2kCDecoder,
+    options: *const J2kCDecodeOptions,
+    out: *mut J2kCOutputInfo,
+    error: *mut J2kCError,
+) -> u32 {
+    // SAFETY: Caller supplies live disjoint storage; prefixes are validated first.
+    unsafe {
+        boundary(error, || {
+            validate_struct(out)?;
+            let options = read_options(options)?;

From e007dcfeb8f7352cabb262d5bd1f30476bffe1f8 Mon Sep 17 00:00:00 2001
From: Justin Jacob <159104807+Justin24506@users.noreply.github.com>
Date: Tue, 24 Nov 2026 00:57:52 +0530
Subject: [PATCH 08/11] avcodec/jpeg2000: pack the tier-1 context tables

Index the zero-coding table by band first, so the band index is loop
invariant, and store a sign context with its XOR bit in one entry so a
sign needs a single load. Add the tables the packed tier-1
representation indexes: the 3x3 window of a stripe column, and the
cardinal-neighbour significance and sign key of a sign context.

Make the significance update inline; the encoder and decoder both call
it once per significant coefficient.

Signed-off-by: Justin Jacob <159104807+Justin24506@users.noreply.github.com>
---
 libavcodec/jpeg2000.c | 72 ++++++++++++++++++++++++++-----------------
 libavcodec/jpeg2000.h | 45 +++++++++++++++++++++------
 2 files changed, 79 insertions(+), 38 deletions(-)

diff --git a/libavcodec/jpeg2000.c b/libavcodec/jpeg2000.c
index a21f9c2a82..8168c84518 100644
--- a/libavcodec/jpeg2000.c
+++ b/libavcodec/jpeg2000.c
@@ -82,7 +82,11 @@ void ff_tag_tree_zero(Jpeg2000TgtNode *t, int w, int h, int val)
     }
 }
 
-uint8_t ff_jpeg2000_sigctxno_lut[256][4];
+uint8_t ff_jpeg2000_sigctxno_lut[4][256];
+/* Zero-coding context of a packed stripe column's 3x3 window, and sign
+ * context and XOR bit of its cardinal-neighbour key. */
+uint8_t ff_jpeg2000_sigctxno_window_lut[4][512];
+uint16_t ff_jpeg2000_sgnctxno_packed_lut[256];
 
 static int getsigctxno(int flag, int bandno)
 {
@@ -127,7 +131,8 @@ static int getsigctxno(int flag, int bandno)
     return 0;
 }
 
-uint8_t ff_jpeg2000_sgnctxno_lut[16][16], ff_jpeg2000_xorbit_lut[16][16];
+static uint8_t ff_jpeg2000_sgnctxno_lut[16][16];
+uint8_t ff_jpeg2000_sgn_lut[16][16];
 
 static const int contribtab[3][3] = { {  0, -1,  1 }, { -1, -1,  0 }, {  1,  0,  1 } };
 static const int  ctxlbltab[3][3] = { { 13, 12, 11 }, { 10,  9, 10 }, { 11, 12, 13 } };
@@ -151,11 +156,44 @@ static void av_cold jpeg2000_init_tier1_luts(void)
     int i, j;
     for (i = 0; i < 256; i++)
         for (j = 0; j < 4; j++)
-            ff_jpeg2000_sigctxno_lut[i][j] = getsigctxno(i, j);
+            ff_jpeg2000_sigctxno_lut[j][i] = getsigctxno(i, j);
     for (i = 0; i < 16; i++)
-        for (j = 0; j < 16; j++)
-            ff_jpeg2000_sgnctxno_lut[i][j] =
-                getsgnctxno(i + (j << 8), &ff_jpeg2000_xorbit_lut[i][j]);
+        for (j = 0; j < 16; j++) {
+            uint8_t xorbit;
+
+            ff_jpeg2000_sgnctxno_lut[i][j] = getsgnctxno(i + (j << 8), &xorbit);
+            /* Context and XOR bit in one byte: the decoder needs both and
+             * fetching them together saves a dependent load per sign. */
+            ff_jpeg2000_sgn_lut[i][j] = ff_jpeg2000_sgnctxno_lut[i][j] |
+                                       (xorbit << 4);
+        }
+    /* The packed tier-1 representation indexes a 3x3 window whose neighbour
+     * order differs from the flag words; translate once here. */
+    for (i = 0; i < 512; i++) {
+        int flag = (((i >> 1) & 1) << 0) | (((i >> 5) & 1) << 1) |
+                   (((i >> 3) & 1) << 2) | (((i >> 7) & 1) << 3) |
+                   (((i >> 2) & 1) << 4) | (((i >> 0) & 1) << 5) |
+                   (((i >> 8) & 1) << 6) | (((i >> 6) & 1) << 7);
+
+        for (j = 0; j < 4; j++)
+            ff_jpeg2000_sigctxno_window_lut[j][i] =
+                ff_jpeg2000_sigctxno_lut[j][flag];
+    }
+    /* Cardinal neighbours: significance in bits 6/4/2/0, sign in 7/5/3/1. */
+    for (i = 0; i < 256; i++) {
+        int flag = ((i & 0x40) ? JPEG2000_T1_SIG_N : 0) |
+                   ((i & 0x10) ? JPEG2000_T1_SIG_W : 0) |
+                   ((i & 0x04) ? JPEG2000_T1_SIG_E : 0) |
+                   ((i & 0x01) ? JPEG2000_T1_SIG_S : 0) |
+                   ((i & 0x80) ? JPEG2000_T1_SGN_N : 0) |
+                   ((i & 0x20) ? JPEG2000_T1_SGN_W : 0) |
+                   ((i & 0x08) ? JPEG2000_T1_SGN_E : 0) |
+                   ((i & 0x02) ? JPEG2000_T1_SGN_S : 0);
+        uint8_t xorbit;
+        int ctxno = getsgnctxno(flag, &xorbit);
+
+        ff_jpeg2000_sgnctxno_packed_lut[i] = ctxno | (xorbit << 8);
+    }
 }
 
 void av_cold ff_jpeg2000_init_tier1_luts(void)
@@ -164,28 +202,6 @@ void av_cold ff_jpeg2000_init_tier1_luts(void)
     ff_thread_once(&init_static_once, jpeg2000_init_tier1_luts);
 }
 
-void ff_jpeg2000_set_significance(Jpeg2000T1Context *t1, int x, int y,
-                                  int negative)
-{
-    x++;
-    y++;
-    t1->flags[(y) * t1->stride + x] |= JPEG2000_T1_SIG;
-    if (negative) {
-        t1->flags[(y) * t1->stride + x + 1] |= JPEG2000_T1_SIG_W | JPEG2000_T1_SGN_W;
-        t1->flags[(y) * t1->stride + x - 1] |= JPEG2000_T1_SIG_E | JPEG2000_T1_SGN_E;
-        t1->flags[(y + 1) * t1->stride + x] |= JPEG2000_T1_SIG_N | JPEG2000_T1_SGN_N;
-        t1->flags[(y - 1) * t1->stride + x] |= JPEG2000_T1_SIG_S | JPEG2000_T1_SGN_S;
-    } else {
-        t1->flags[(y) * t1->stride + x + 1] |= JPEG2000_T1_SIG_W;
-        t1->flags[(y) * t1->stride + x - 1] |= JPEG2000_T1_SIG_E;
-        t1->flags[(y + 1) * t1->stride + x] |= JPEG2000_T1_SIG_N;
-        t1->flags[(y - 1) * t1->stride + x] |= JPEG2000_T1_SIG_S;
-    }
-    t1->flags[(y + 1) * t1->stride + x + 1] |= JPEG2000_T1_SIG_NW;
-    t1->flags[(y + 1) * t1->stride + x - 1] |= JPEG2000_T1_SIG_NE;
-    t1->flags[(y - 1) * t1->stride + x + 1] |= JPEG2000_T1_SIG_SW;
-    t1->flags[(y - 1) * t1->stride + x - 1] |= JPEG2000_T1_SIG_SE;
-}
 
 /* TODO: Implementation of quantization step not finished, see
  * ISO/IEC 15444-1:2002 E.1 and A.6.4. */
diff --git a/libavcodec/jpeg2000.h b/libavcodec/jpeg2000.h
index 52c00f4268..82944d6f83 100644
--- a/libavcodec/jpeg2000.h
+++ b/libavcodec/jpeg2000.h
@@ -133,7 +133,10 @@ enum Jpeg2000Quantsty { // quantization style
 
 typedef struct Jpeg2000T1Context {
     int data[6144];
-    uint16_t flags[6156];
+    union {
+        uint16_t flags[6156];   ///< a word per coefficient; the encoder
+        uint32_t flags32[3078]; ///< a word per stripe column; the decoder
+    };
     MqcState mqc;
     int stride;
 } Jpeg2000T1Context;
@@ -261,16 +264,37 @@ void ff_jpeg2000_init_tier1_luts(void);
 
 /* Update significance of a coefficient at current position (x,y) and
  * for neighbors. */
-void ff_jpeg2000_set_significance(Jpeg2000T1Context *t1,
-                                  int x, int y, int negative);
+static av_always_inline
+void ff_jpeg2000_set_significance(Jpeg2000T1Context *t1, int x, int y,
+                                  int negative)
+{
+    uint16_t *p = t1->flags + (y + 1) * t1->stride + x + 1;
+    /* The sign bits of the four edge neighbors are updated together; keeping
+     * the update branchless matters because the sign is close to random. */
+    unsigned sgn = (unsigned)-(negative != 0) &
+                   (JPEG2000_T1_SGN_N | JPEG2000_T1_SGN_S |
+                    JPEG2000_T1_SGN_W | JPEG2000_T1_SGN_E);
+
+    p[0]               |= JPEG2000_T1_SIG;
+    p[1]               |= JPEG2000_T1_SIG_W | (sgn & JPEG2000_T1_SGN_W);
+    p[-1]              |= JPEG2000_T1_SIG_E | (sgn & JPEG2000_T1_SGN_E);
+    p[t1->stride]      |= JPEG2000_T1_SIG_N | (sgn & JPEG2000_T1_SGN_N);
+    p[-t1->stride]     |= JPEG2000_T1_SIG_S | (sgn & JPEG2000_T1_SGN_S);
+    p[t1->stride + 1]  |= JPEG2000_T1_SIG_NW;
+    p[t1->stride - 1]  |= JPEG2000_T1_SIG_NE;
+    p[-t1->stride + 1] |= JPEG2000_T1_SIG_SW;
+    p[-t1->stride - 1] |= JPEG2000_T1_SIG_SE;
+}
 
-extern uint8_t ff_jpeg2000_sigctxno_lut[256][4];
+extern uint8_t ff_jpeg2000_sigctxno_lut[4][256];
+extern uint8_t ff_jpeg2000_sigctxno_window_lut[4][512];
+extern uint16_t ff_jpeg2000_sgnctxno_packed_lut[256];
 
 /* Get context label (number in range[0..8]) of a coefficient for significance
  * propagation and cleanup coding passes. */
 static inline int ff_jpeg2000_getsigctxno(int flag, int bandno)
 {
-    return ff_jpeg2000_sigctxno_lut[flag & 255][bandno];
+    return ff_jpeg2000_sigctxno_lut[bandno][flag & 255];
 }
 
 static const uint8_t refctxno_lut[2][2] = { { 14, 15 }, { 16, 16 } };
@@ -282,14 +306,15 @@ static inline int ff_jpeg2000_getrefctxno(int flag)
     return refctxno_lut[(flag >> 14) & 1][(flag & 255) != 0];
 }
 
-extern uint8_t ff_jpeg2000_sgnctxno_lut[16][16];
-extern uint8_t ff_jpeg2000_xorbit_lut[16][16];
+extern uint8_t ff_jpeg2000_sgn_lut[16][16];
 
-/* Get context label (number in range[9..13]) for sign decoding. */
+/* Context label (9..13) in the low nibble, XOR bit in bit 4. */
 static inline int ff_jpeg2000_getsgnctxno(int flag, int *xorbit)
 {
-    *xorbit = ff_jpeg2000_xorbit_lut[flag & 15][(flag >> 8) & 15];
-    return ff_jpeg2000_sgnctxno_lut[flag & 15][(flag >> 8) & 15];
+    int s = ff_jpeg2000_sgn_lut[flag & 15][(flag >> 8) & 15];
+
+    *xorbit = s >> 4;
+    return s & 15;
 }
 
 /* Node count of the tag-tree pyramid over a (w, h) leaf grid. */

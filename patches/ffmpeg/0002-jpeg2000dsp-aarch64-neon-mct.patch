From bc99572eb83c8de820ee0206780d42e6e8b1ef56 Mon Sep 17 00:00:00 2001
From: Justin Jacob <159104807+Justin24506@users.noreply.github.com>
Date: Sat, 21 Nov 2026 17:40:05 +0530
Subject: [PATCH 02/11] avcodec/jpeg2000dsp: add aarch64 NEON ICT and RCT

aarch64 falls back to C for the JPEG 2000 irreversible and reversible
multi-component transforms. Add NEON implementations following the
existing x86 and RISC-V code, closing the architecture gap and removing
reliance on compiler auto-vectorization.

Signed-off-by: Justin Jacob <159104807+Justin24506@users.noreply.github.com>
---
 libavcodec/aarch64/Makefile                   |   2 +
 libavcodec/aarch64/jpeg2000dsp_init_aarch64.c |  37 ++++++
 libavcodec/aarch64/jpeg2000dsp_neon.S         | 119 ++++++++++++++++++
 libavcodec/jpeg2000dsp.c                      |   4 +-
 libavcodec/jpeg2000dsp.h                      |   1 +
 5 files changed, 162 insertions(+), 1 deletion(-)
 create mode 100644 libavcodec/aarch64/jpeg2000dsp_init_aarch64.c
 create mode 100644 libavcodec/aarch64/jpeg2000dsp_neon.S

diff --git a/libavcodec/aarch64/Makefile b/libavcodec/aarch64/Makefile
index e560a8c312..2e3397e915 100644
--- a/libavcodec/aarch64/Makefile
+++ b/libavcodec/aarch64/Makefile
@@ -9,6 +9,7 @@ OBJS-$(CONFIG_H264PRED)                 += aarch64/h264pred_init.o
 OBJS-$(CONFIG_H264QPEL)                 += aarch64/h264qpel_init_aarch64.o
 OBJS-$(CONFIG_HPELDSP)                  += aarch64/hpeldsp_init_aarch64.o
 OBJS-$(CONFIG_IDCTDSP)                  += aarch64/idctdsp_init_aarch64.o
+OBJS-$(CONFIG_JPEG2000_DECODER)         += aarch64/jpeg2000dsp_init_aarch64.o
 OBJS-$(CONFIG_LLVIDDSP)                 += aarch64/lossless_videodsp_init.o
 OBJS-$(CONFIG_ME_CMP)                   += aarch64/me_cmp_init_aarch64.o
 OBJS-$(CONFIG_MPEGAUDIODSP)             += aarch64/mpegaudiodsp_init.o
@@ -61,6 +62,7 @@ NEON-OBJS-$(CONFIG_HPELDSP)             += aarch64/hpeldsp_neon.o
 NEON-OBJS-$(CONFIG_HUFFYUVDSP)          += aarch64/huffyuvdsp_neon.o
 NEON-OBJS-$(CONFIG_IDCTDSP)             += aarch64/idctdsp_neon.o              \
                                            aarch64/simple_idct_neon.o
+NEON-OBJS-$(CONFIG_JPEG2000_DECODER)    += aarch64/jpeg2000dsp_neon.o
 NEON-OBJS-$(CONFIG_LLVIDDSP)            += aarch64/lossless_videodsp_neon.o
 NEON-OBJS-$(CONFIG_ME_CMP)              += aarch64/me_cmp_neon.o
 NEON-OBJS-$(CONFIG_MPEGAUDIODSP)        += aarch64/mpegaudiodsp_neon.o

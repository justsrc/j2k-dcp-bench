# mpv meson options for the DCP build.
#
# Matches the reference justsrc/mpv-builder nightly's feature set so the DCP
# build does not give up any player integration. The workflow appends the
# libj2k/Homebrew link arguments; `-Dobjc_link_args` and `-Dc_link_args` are
# intentionally left to the workflow so there is exactly one definition.
-Dc_args=-Werror
-Dobjc_args=-Werror -Wno-error=deprecated -Wno-error=deprecated-declarations
-Dtests=true
-Dvideotoolbox-gl=enabled
-Dcocoa=enabled
-Dcaca=enabled
-Dlcms2=enabled
-Dlua=enabled
-Djavascript=enabled
-Dlibarchive=enabled
-Dsixel=enabled
-Dvapoursynth=enabled
-Drubberband=enabled
-Duchardet=enabled
-Dmanpage-build=enabled
-Dmacos-touchbar=enabled
-Ddvdnav=enabled
-Dcdda=enabled
-Diconv=enabled
-Dswift-flags=-target arm64-apple-macosx12.0
